# Mientras solo se muestra el frontend se puede usar "demo".
# Antes de publicar con usuarios reales debe cambiarse obligatoriamente a "api".
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL local o URL agrupada (pooled) de Neon.
DATABASE_URL=postgresql://aula:aula@localhost:5432/aula_segura

# Secreto exclusivo para anonimizar señales del límite de login.
RATE_LIMIT_PEPPER=replace-with-a-random-secret-of-at-least-32-characters

# Secreto independiente para hashear tokens y dispositivos.
SESSION_TOKEN_PEPPER=replace-with-another-random-secret-of-at-least-32-characters

# Cloudflare R2 privado. Variables exclusivas del backend/worker.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aula-private-documents
